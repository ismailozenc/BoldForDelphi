<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tutorial 4, a WinForms desk (it runs on Windows). Outside this repository, reference the packages Bold.WinForms and
    Bold.Persistence.Sql, and Bold.Propagation and Bold.Remote.Client for working on a server.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets this project compile on Linux and macOS as well (it runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>The Library examples, tutorial 4: a WinForms desk for the library, with authors and their books, members and their loans in grids that follow the current object, navigators, lending and returning, undo and redo, saving, and an auto form on a double click; on a database of its own, or on the server of tutorial 5.</Description>
    <RootNamespace>Library.Desk</RootNamespace>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/SqliteSystem.cs" Link="SqliteSystem.cs" />
    <Compile Include="../Network/LibraryClient.cs" Link="LibraryClient.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Bold.Porting/Bold.Porting.csproj" />
    <ProjectReference Include="../../../src/Bold.Rtl/Bold.Rtl.csproj" />
    <ProjectReference Include="../../../src/Bold.Core/Bold.Core.csproj" />
    <ProjectReference Include="../../../src/Bold.Model/Bold.Model.csproj" />
    <ProjectReference Include="../../../src/Bold.ValueSpace/Bold.ValueSpace.csproj" />
    <ProjectReference Include="../../../src/Bold.Persistence/Bold.Persistence.csproj" />
    <ProjectReference Include="../../../src/Bold.ObjectSpace/Bold.ObjectSpace.csproj" />
    <ProjectReference Include="../../../src/Bold.Persistence.Sql/Bold.Persistence.Sql.csproj" />
    <ProjectReference Include="../../../src/Bold.Handles/Bold.Handles.csproj" />
    <ProjectReference Include="../../../src/Bold.AwareGui/Bold.AwareGui.csproj" />
    <ProjectReference Include="../../../src/Bold.WinForms/Bold.WinForms.csproj" />
    <ProjectReference Include="../../../src/Bold.Propagation/Bold.Propagation.csproj" />
    <ProjectReference Include="../../../src/Bold.Remote.Client/Bold.Remote.Client.csproj" />
    <ProjectReference Include="../LibraryClasses/LibraryClasses.csproj" />
  </ItemGroup>
</Project>
