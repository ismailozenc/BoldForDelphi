<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Library model's classes. bold-codegen writes the *.g.cs files from Library.bld (tutorial 2 shows how), and
    Member.cs and Loan.cs hold the methods and the derivation the model declares, written by hand.
  -->
  <PropertyGroup>
    <Description>The classes of the Library examples' model (Library.bld), generated by bold-codegen, with the methods Member.Borrow and Loan.CompleteCreate and the member Loan.Overdue derived in code.</Description>
    <RootNamespace>LibraryClasses</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Bold.Porting/Bold.Porting.csproj" />
    <ProjectReference Include="../../../src/Bold.Rtl/Bold.Rtl.csproj" />
    <ProjectReference Include="../../../src/Bold.Core/Bold.Core.csproj" />
    <ProjectReference Include="../../../src/Bold.Model/Bold.Model.csproj" />
    <ProjectReference Include="../../../src/Bold.ValueSpace/Bold.ValueSpace.csproj" />
    <ProjectReference Include="../../../src/Bold.Persistence/Bold.Persistence.csproj" />
    <ProjectReference Include="../../../src/Bold.ObjectSpace/Bold.ObjectSpace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The model travels with its classes: LibraryModel.Lines() reads it. -->
    <EmbeddedResource Include="../Library.bld" LogicalName="LibraryClasses.Library.bld" Link="Library.bld" />
  </ItemGroup>
</Project>
