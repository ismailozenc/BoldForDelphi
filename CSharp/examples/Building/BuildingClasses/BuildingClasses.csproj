<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The Building example's model classes, generated by bold-codegen from Building.bld (the Building and Bios examples of Delphi Bold), with the methods written by hand in Building.cs, Person.cs and ResidentialBuilding.cs.</Description>
    <RootNamespace>BuildingClasses</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Bold.Porting/Bold.Porting.csproj" />
    <ProjectReference Include="../../../src/Bold.Rtl/Bold.Rtl.csproj" />
    <ProjectReference Include="../../../src/Bold.Core/Bold.Core.csproj" />
    <ProjectReference Include="../../../src/Bold.Model/Bold.Model.csproj" />
    <ProjectReference Include="../../../src/Bold.ValueSpace/Bold.ValueSpace.csproj" />
    <ProjectReference Include="../../../src/Bold.Persistence/Bold.Persistence.csproj" />
    <ProjectReference Include="../../../src/Bold.ObjectSpace/Bold.ObjectSpace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The model travels with its classes. -->
    <EmbeddedResource Include="Building.bld" LogicalName="BuildingClasses.Building.bld" />
  </ItemGroup>
</Project>
