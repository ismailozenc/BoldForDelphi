<Project>
  <!-- Settings shared by every project in the Bold C# port. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- All ported code lives in one namespace, as Delphi units share one name space. -->
    <RootNamespace>Bold</RootNamespace>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BoldCSharpRoot>$(MSBuildThisFileDirectory)</BoldCSharpRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- [Delphi(...)] and [Covers(...)] are used in every file of the port. -->
    <Using Include="Bold.Porting" />
  </ItemGroup>
</Project>
