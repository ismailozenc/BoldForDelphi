<Project>
  <!--
    Delphi type aliases (for example "TBoldTimeStampType = integer") are ported as C# global using
    aliases in files named <Unit>.Aliases.cs. In Delphi such a name is visible in every unit that uses
    the declaring unit. To match that, each project also compiles the alias files of the projects it
    references directly. Rule: reference every Bold project whose names you use, not only through
    another project.
  -->
  <Target Name="BoldIncludeReferencedAliases" BeforeTargets="CoreCompile" Condition="'@(ProjectReference)' != ''">
    <ItemGroup>
      <_BoldReferencedProjectDir Include="@(ProjectReference->'%(RootDir)%(Directory)')" />
      <_BoldReferencedAliasFile Include="%(_BoldReferencedProjectDir.Identity)**/*.Aliases.cs"
                                Exclude="%(_BoldReferencedProjectDir.Identity)obj/**;%(_BoldReferencedProjectDir.Identity)bin/**" />
      <Compile Include="@(_BoldReferencedAliasFile)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!--
    Packages. Each carries the package readme. A library's package also carries its alias files, and a buildTransitive
    file (deploy/Bold.Package.targets) that compiles them into every project using the package, directly or through
    another package: the projects using the packages see the Delphi type names as the projects here do.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(BoldCSharpRoot)deploy/PACKAGE.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(PackAsTool)' != 'true' and '$(IsRoslynComponent)' != 'true'">
    <None Include="$(MSBuildProjectDirectory)/**/*.Aliases.cs" Exclude="$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**"
          Pack="true" PackagePath="aliases/" Visible="false" />
    <None Include="$(BoldCSharpRoot)deploy/Bold.Package.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" Visible="false" />
  </ItemGroup>
</Project>
