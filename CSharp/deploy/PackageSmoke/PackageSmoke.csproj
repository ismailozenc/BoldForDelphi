<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Uses Bold as an application outside this repository does: from the packages dotnet pack wrote (artifacts/packages,
    see nuget.config), with the classes that the bold-codegen tool from those packages wrote for Library.bld, on a
    SQLite database. deploy/check.sh generates the classes, then builds and runs it; it is not part of Bold.slnx.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <BoldVersion Condition="'$(BoldVersion)' == ''">1.0.0</BoldVersion>
    <!-- Where bold-codegen wrote the classes of Library.bld. -->
    <BoldGenerated Condition="'$(BoldGenerated)' == ''">$(MSBuildThisFileDirectory)../../artifacts/smoke/generated</BoldGenerated>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Bold.Persistence.Sql" Version="$(BoldVersion)" />
    <PackageReference Include="Bold.Handles" Version="$(BoldVersion)" />
    <PackageReference Include="Bold.SourceGenerators" Version="$(BoldVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(BoldGenerated)/**/*.cs" />
    <None Update="Library.bld" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(BoldOffline)' != 'true'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>
  <!-- Offline (no feed but a local one) the small native SQLite provider of the SQL tests stands in for Microsoft.Data.Sqlite. -->
  <PropertyGroup Condition="'$(BoldOffline)' == 'true'">
    <DefineConstants>$(DefineConstants);BOLD_OFFLINE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(BoldOffline)' == 'true'">
    <Compile Include="../../tests/Bold.Persistence.Sql.Tests/Support/NativeSqlite.cs" Link="NativeSqlite.cs" />
  </ItemGroup>
</Project>
