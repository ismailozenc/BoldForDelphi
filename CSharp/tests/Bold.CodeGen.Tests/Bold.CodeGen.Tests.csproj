<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Tests of Bold.CodeGen and the template support of Bold.Core: template expansion, the Delphi and C++ templates, and C# code generated for every fixture model, compiled and used. Test files mirror the Delphi paths.</Description>
  </PropertyGroup>
  <!-- Roslyn compiles the generated code. Offline builds have no package feed and use the compiler of the SDK. -->
  <ItemGroup Condition="'$(BoldOffline)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(BoldOffline)' == 'true'">
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(RoslynTargetsPath)/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(RoslynTargetsPath)/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Bold.Core/Bold.Core.csproj" />
    <ProjectReference Include="../../src/Bold.Model/Bold.Model.csproj" />
    <ProjectReference Include="../../src/Bold.ValueSpace/Bold.ValueSpace.csproj" />
    <ProjectReference Include="../../src/Bold.Persistence/Bold.Persistence.csproj" />
    <ProjectReference Include="../../src/Bold.ObjectSpace/Bold.ObjectSpace.csproj" />
    <ProjectReference Include="../../src/Bold.CodeGen/Bold.CodeGen.csproj" />
    <!-- The Building example's classes, generated by bold-codegen: typed access is tested on them. -->
    <ProjectReference Include="../../examples/Building/BuildingClasses/BuildingClasses.csproj" />
  </ItemGroup>
</Project>
