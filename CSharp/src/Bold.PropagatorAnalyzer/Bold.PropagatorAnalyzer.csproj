<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The propagator analyzer: reads a propagator's thread log and lists the locks each thread took after another, to find lock orders that can deadlock.</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets this project compile on Linux and macOS as well. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <!-- A program, published rather than packed (dotnet publish). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bold.PropagatorAnalyzer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bold.Porting/Bold.Porting.csproj" />
    <ProjectReference Include="../Bold.Rtl/Bold.Rtl.csproj" />
  </ItemGroup>
</Project>
