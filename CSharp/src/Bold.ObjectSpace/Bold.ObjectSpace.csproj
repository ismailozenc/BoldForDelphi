<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Runtime type info, the object space, undo, lock regions and OCL.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bold.Porting/Bold.Porting.csproj" />
    <ProjectReference Include="../Bold.Rtl/Bold.Rtl.csproj" />
    <ProjectReference Include="../Bold.Core/Bold.Core.csproj" />
    <ProjectReference Include="../Bold.Model/Bold.Model.csproj" />
    <ProjectReference Include="../Bold.ValueSpace/Bold.ValueSpace.csproj" />
    <ProjectReference Include="../Bold.Persistence/Bold.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The generated OCL scanner and parser tables, linked from the Delphi sources (BoldOcl.rc). -->
    <EmbeddedResource Include="$(BoldCSharpRoot)../Source/ObjectSpace/Ocl/BoldOcl.dfa" LogicalName="OCLSCANNERTABLE" Link="ObjectSpace/Ocl/BoldOcl.dfa" />
    <EmbeddedResource Include="$(BoldCSharpRoot)../Source/ObjectSpace/Ocl/BoldOcl.llr" LogicalName="OCLPARSERTABLE" Link="ObjectSpace/Ocl/BoldOcl.llr" />
  </ItemGroup>
</Project>
