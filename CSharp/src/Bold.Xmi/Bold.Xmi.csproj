<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>XMI 1.x import and XMI 2.x import and export for the Mold model.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bold.Porting/Bold.Porting.csproj" />
    <ProjectReference Include="../Bold.Rtl/Bold.Rtl.csproj" />
    <ProjectReference Include="../Bold.Core/Bold.Core.csproj" />
    <ProjectReference Include="../Bold.Model/Bold.Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The members of each class of the UML 1.3 metamodel, in the order of its XMI DTD (Delphi's BoldUMLDTDData). -->
    <EmbeddedResource Include="UMLModel/ModelLinks/XMI/BoldUMLDTDData.uml13.txt" LogicalName="BoldUMLDTDData.uml13.txt" />
  </ItemGroup>
  <!--
    The pictures of Delphi's component palette (Images/Components), embedded under the class's name: Visual Studio's
    toolbox and the designer's component tray show the bitmap named as the component (Bold.TBoldGrid.bmp for TBoldGrid).
  -->
  <ItemGroup>
    <BoldToolboxBitmap Include="TBoldUMLXMILink" />
  </ItemGroup>
</Project>
