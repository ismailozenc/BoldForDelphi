<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Remote persistence server on ASP.NET Core, with the propagator on the same host when configured. A program, and a library for offering persistence from another ASP.NET Core application (MapBoldPersistence).</Description>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- The web SDK packs nothing by default; this server is also a library. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The program's settings stay out of the package: an application hosting the persistence has its own. -->
    <Content Update="appsettings.json" Pack="false" />
  </ItemGroup>
  <!--
    The database providers the server is published with. The code loads them by name only (TBoldRemotePersistenceSetup),
    so the package does not bring them: an application hosting the persistence adds the provider it uses.
  -->
  <ItemGroup Condition="'$(BoldOffline)' != 'true'">
    <PackageReference Include="Microsoft.Data.Sqlite" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.SqlClient" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bold.Porting/Bold.Porting.csproj" />
    <ProjectReference Include="../Bold.Rtl/Bold.Rtl.csproj" />
    <ProjectReference Include="../Bold.Core/Bold.Core.csproj" />
    <ProjectReference Include="../Bold.Model/Bold.Model.csproj" />
    <ProjectReference Include="../Bold.ValueSpace/Bold.ValueSpace.csproj" />
    <ProjectReference Include="../Bold.Persistence/Bold.Persistence.csproj" />
    <ProjectReference Include="../Bold.ObjectSpace/Bold.ObjectSpace.csproj" />
    <ProjectReference Include="../Bold.Persistence.Sql/Bold.Persistence.Sql.csproj" />
    <ProjectReference Include="../Bold.Remote.Client/Bold.Remote.Client.csproj" />
    <ProjectReference Include="../Bold.Propagation/Bold.Propagation.csproj" />
    <ProjectReference Include="../Bold.Propagator.Server/Bold.Propagator.Server.csproj" />
  </ItemGroup>
</Project>
